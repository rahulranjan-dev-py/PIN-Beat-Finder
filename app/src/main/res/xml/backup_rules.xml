<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Only the staff's own beat records are backed up. The bundled All-India directory is
         re-seeded from the APK asset on first launch (and is far above the backup quota), and
         cache exports plus the HTTP cache are regenerable. -->
    <include domain="database" path="." />
    <exclude domain="database" path="india_post_directory.db" />
    <exclude domain="database" path="india_post_directory.db-wal" />
    <exclude domain="database" path="india_post_directory.db-shm" />
    <exclude domain="database" path="india_post_directory.db-journal" />
</full-backup-content>
