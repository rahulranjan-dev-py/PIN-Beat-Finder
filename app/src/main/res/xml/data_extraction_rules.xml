<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Beat records only: the bundled directory is re-seeded from the APK and would blow the
         cloud-backup quota. -->
    <cloud-backup>
        <include domain="database" path="." />
        <exclude domain="database" path="india_post_directory.db" />
        <exclude domain="database" path="india_post_directory.db-wal" />
        <exclude domain="database" path="india_post_directory.db-shm" />
        <exclude domain="database" path="india_post_directory.db-journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="database" path="india_post_directory.db" />
        <exclude domain="database" path="india_post_directory.db-wal" />
        <exclude domain="database" path="india_post_directory.db-shm" />
        <exclude domain="database" path="india_post_directory.db-journal" />
    </device-transfer>
</data-extraction-rules>
